APP_ENV=development
POSTGRES_DB=chess_analyzer
POSTGRES_USER=chess_user
POSTGRES_PASSWORD=chess_password
DATABASE_URL=postgresql+psycopg://chess_user:chess_password@localhost:5432/chess_analyzer
RABBITMQ_USER=chess_user
RABBITMQ_PASSWORD=chess_password
CELERY_BROKER_URL=amqp://chess_user:chess_password@localhost:5672//
STOCKFISH_PATH=stockfish
STOCKFISH_DEPTH=20
STOCKFISH_THREADS=1
STOCKFISH_HASH_MB=64
STOCKFISH_TIMEOUT_SECONDS=120
ANALYSIS_PV_LENGTH=4
